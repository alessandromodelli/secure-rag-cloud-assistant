# catalog-service runtime environment (development tier)
# Non-secret runtime configuration for the catalog-service dev deployment.
# Secret material (DB password, API keys) is injected at runtime via
# secretKeyRef and is NOT present in this file. Classification: INTERNAL.

SERVICE_NAME=catalog-service
ENVIRONMENT=dev
LOG_LEVEL=debug
HTTP_CLIENT_TIMEOUT_SEC=30
HTTP_SERVER_READ_TIMEOUT_SEC=60
HTTP_SERVER_WRITE_TIMEOUT_SEC=60
WORKER_CONCURRENCY=4

# Service discovery (in-cluster DNS names, non-secret)
DB_HOST=acme-dev-catalog-postgres.internal.acme.example
DB_PORT=5432
DB_NAME=catalog
REDIS_HOST=acme-dev-catalog-redis.internal.acme.example
REDIS_PORT=6379

# Feature flag evaluation endpoint (shared dev flag service)
FEATURE_FLAG_HOST=flags.dev.internal.acme.example

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4317
METRICS_ENABLED=true
