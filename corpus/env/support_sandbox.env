# support reproduction sandbox environment (support tooling)
# Non-secret configuration for the support team's local reproduction sandbox
# described in support_incident_reproduction_sandbox.md. Every value here is a
# placeholder used against the local mock stack; no real credential is present
# and none may be substituted. Classification: INTERNAL.

SERVICE_NAME=support-sandbox
ENVIRONMENT=sandbox
LOG_LEVEL=debug

# Local mock stack (docker-compose), in-container hostnames only
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sandbox
DB_USER=sandbox_app
DB_PASSWORD=local-dev-only
REDIS_HOST=localhost
REDIS_PORT=6379

# Local payment provider mock (canned responses)
PAYMENT_PROVIDER_URL=http://localhost:9999
PAYMENT_PROVIDER_API_KEY=mock-key-for-local

# Static token checked against a hard-coded value inside the mock
LOCAL_AUTH_TOKEN=local-mock-token

# Fixture seeding
SEED_FIXTURE=default
SEED_DEMO_USERS=10
