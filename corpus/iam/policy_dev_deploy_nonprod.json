{
  "policy_name": "DevTeamDeployNonProd",
  "policy_id": "POL-2024-0311",
  "description": "Deployment permissions for the development team scoped to non-production environments. Grants image push to the application ECR namespaces and workload deployment in the dev and staging clusters, with an explicit deny on any production-scoped resource.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPushApplicationImages",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken",
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": "arn:aws:ecr:eu-west-1:123456789012:repository/acme-app-*"
    },
    {
      "Sid": "AllowDeployNonProdWorkloads",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster",
        "eks:AccessKubernetesApi"
      ],
      "Resource": [
        "arn:aws:eks:eu-west-1:123456789012:cluster/acme-dev",
        "arn:aws:eks:eu-west-1:123456789012:cluster/acme-staging"
      ]
    },
    {
      "Sid": "AllowReadNonProdParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:eu-west-1:123456789012:parameter/acme/nonprod/*"
    },
    {
      "Sid": "DenyAllProductionScope",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:eks:eu-west-1:123456789012:cluster/acme-prod",
        "arn:aws:ssm:eu-west-1:123456789012:parameter/acme/prod/*"
      ]
    }
  ],
  "attached_to": ["dev-team-group"],
  "notes": "Reviewed and approved by the security team on 2024-09-02. Non-production deployment baseline for application teams; production deployment remains gated behind the change-controlled pipeline identity. Next review at the quarterly access review cadence."
}
